# GEMINI_API_KEY: Required for optional Gemini AI fallback parsing.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CRAWL4AI_BASE_URL: URL of the independent Crawl4AI Google Cloud Run service
# (e.g., https://atelierfit-crawl4ai-xxxxx-as.a.run.app or http://localhost:11235)
CRAWL4AI_BASE_URL=""

# CRAWL4AI_API_TOKEN: Bearer authentication token for the Crawl4AI Cloud Run service
CRAWL4AI_API_TOKEN=""

# SHOPIFY_AUTHORIZED_DOMAINS: Comma-separated list of Shopify store domains authorized for extraction
SHOPIFY_AUTHORIZED_DOMAINS="taylorstitch.com,www.taylorstitch.com,allbirds.com,www.allbirds.com,kotn.com,www.kotn.com,gymshark.com,www.gymshark.com"

# SHOPIFY_STOREFRONT_ACCESS_TOKEN: Optional Shopify Storefront GraphQL API token if private storefront scopes are used
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

